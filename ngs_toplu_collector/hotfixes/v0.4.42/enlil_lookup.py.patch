+def normalize_sex_value(value, allow_initial=False):
+    """Normalize an explicit ENLIL sex value without guessing.
+
+    The pathology result grid does not have a dedicated sex column.  Some ENLIL
+    installations expose patient sex elsewhere in the JAB tree (label/value, selected
+    radio item or combo-box value).  Only explicit male/female values are accepted.
+    """
+    text=normalize(value)
+    if not text:return ''
+    folded=text.casefold().replace('ı','i')
+    compact=re.sub(r'[^a-z0-9çğıöşü]+','',folded)
+    if compact in ('erkek','male','man'):return 'Erkek'
+    if compact in ('kadin','female','woman'):return 'Kadın'
+    if allow_initial and compact in ('e','m'):return 'Erkek'
+    if allow_initial and compact in ('k','f'):return 'Kadın'
+    # Accept labelled forms such as "Cinsiyet: Erkek" / "Sex Female".
+    if re.search(r'\b(erkek|male)\b',folded):return 'Erkek'
+    if re.search(r'\b(kadin|kadın|female)\b',folded):return 'Kadın'
+    return ''
+
