+    def extract_patient_sex(self,tree):
+        """Return explicit patient sex exposed anywhere in the current ENLIL JAB tree.
+
+        Safety rules:
+        - checked/selected Erkek/Kadın controls win;
+        - otherwise a value next to a Cinsiyet/Sex/Gender label may be used;
+        - a whole-tree fallback is accepted only when exactly one explicit sex value is
+          present.  Seeing both unselected radio choices is treated as ambiguous.
+        """
+        nodes=list(tree or [])
+        # 1) Selected control is strongest evidence.
+        for node in nodes:
+            value=normalize_sex_value(self.node_name(node),allow_initial=False)
+            if not value:continue
+            role=self.node_role(node)
+            states=self.node_states(node)
+            if role in ('radio button','check box','combo box','list item') and ('selected' in states or 'checked' in states):
+                return value
+
+        def is_label(text):
+            folded=normalize(text).casefold().replace('ı','i')
+            compact=re.sub(r'[^a-z0-9]+','',folded)
+            return compact in ('cinsiyet','cinsiyeti','sex','gender') or compact.startswith('cinsiyet')
+
+        # 2) Search in the smallest nearby container of a sex label.
+        for label in nodes:
+            if not is_label(self.node_name(label)):continue
+            cur=label
+            for _ in range(3):
+                parent=getattr(cur,'parent',None)
+                if parent is None:break
+                values=[]
+                for raw in self._leaf_names(parent,limit=120):
+                    sx=normalize_sex_value(raw,allow_initial=True)
+                    if sx and sx not in values:values.append(sx)
+                if len(values)==1:return values[0]
+                cur=parent
+
+        # 3) Last-resort exact/unambiguous visible value. Single-letter E/K is not
+        # accepted globally because it is too easy to collide with unrelated controls.
+        values=[]
+        for node in nodes:
+            sx=normalize_sex_value(self.node_name(node),allow_initial=False)
+            if sx and sx not in values:values.append(sx)
+        return values[0] if len(values)==1 else ''
+
+    def _attach_exact_tree_demographics(self,rows,tree,expected_query=''):
+        expected=biopsy_key(expected_query)
+        if not expected:return rows
+        sex=self.extract_patient_sex(tree)
+        if not sex:return rows
+        for row in rows or []:
+            if biopsy_key(row.get('biyopsi_no'))==expected:
+                row['cinsiyet']=sex
+                break
+        return rows
+
